# ─── Charge Sphere — Production Environment Variables ──────────────────────────
# Copy this file to .env and fill in your own values before deploying.
# NEVER commit .env to git — it is already listed in .gitignore.
# ────────────────────────────────────────────────────────────────────────────────

# Your Docker Hub username (the account you pushed images to)
DOCKER_HUB_USERNAME=your_dockerhub_username

# PostgreSQL password — use a strong random string in production
DB_PASSWORD=change_me_strong_password_here

# JWT signing secret — must be the same string across ALL services
# Must be at least 32 characters long
JWT_SECRET=replace_with_your_own_64char_random_secret_string_here_1234567

# EC2 public IP or domain (used when rebuilding the frontend image)
# Example: 54.123.45.67  or  myapp.example.com
EC2_PUBLIC_IP=your_ec2_public_ip_or_domain