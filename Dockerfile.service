# Multi-stage Dockerfile — reusable template for all Spring Boot services
# Replace SERVICE_JAR_NAME with the actual jar name for each service.
# This Dockerfile is used for: api-gateway, user-service, station-service,
#   charging-service, grid-service, load-balancer-service, notification-service

ARG SERVICE_JAR=app.jar

# Stage 1: Build
FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /app
RUN apk add --no-cache maven
COPY pom.xml .
COPY src ./src
RUN mvn package -DskipTests -q

# Stage 2: Runtime (JRE only — smaller image)
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
ARG SERVICE_JAR
COPY --from=builder /app/target/*.jar app.jar

# Expose the service port (overridden per-service in docker-compose)
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD wget -qO- http://localhost:${PORT:-8080}/actuator/health || exit 1

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=70.0", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
